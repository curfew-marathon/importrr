# Copy to .env and fill in your paths:
#   cp .env.example .env
# .env is gitignored. Every variable has a ${VAR:-default} in docker-compose.yml,
# so the compose file still resolves with no .env - but the fallbacks are ./config
# and ./data in this checkout, not your real directories.

# ─────────────────────────────────────────────────────────────────────────────
# Host paths (required for real use)
# ─────────────────────────────────────────────────────────────────────────────

# Directory holding config.ini. Mounted at /config, so importrr reads
# /config/config.ini.
#IMPORTRR_CONFIG_DIR=/srv/importrr/config

# Host directory bound at /data. Use it as the album_dir / archive_dir root in
# config.ini for sections that live on local disk.
#IMPORTRR_DATA_DIR=/srv/importrr/data

# ─────────────────────────────────────────────────────────────────────────────
# Process identity / timezone
# ─────────────────────────────────────────────────────────────────────────────

# Passed through to the container. NOTE: the current image (plain python:alpine,
# no s6 init) does not act on PUID/PGID - the process runs as root regardless.
# Kept for parity with the previous compose file and a future base that honours them.
#PUID=1000
#PGID=1000

# Timezone for log timestamps, e.g. America/New_York, Europe/Berlin. tzdata is in
# the image; unset falls back to UTC.
#TZ=UTC

# ─────────────────────────────────────────────────────────────────────────────
# NFS shares
# ─────────────────────────────────────────────────────────────────────────────
# Two NFS volumes are mounted into the container (docker-compose.yml). Point the
# TARGET at a path your config.ini uses as an album_dir / archive_dir root; the
# EXPORT is the path on the NFS server. Not using a share? Leave its vars as-is
# and delete that volume + mount from docker-compose.yml.

# NFS server host or IP, shared by both shares below.
#NAS_ADDR=nas.example

# Mount options for both shares (everything after addr=). Default is
# nolock,hard,rw - hard so a stalled server blocks the writer instead of
# returning an I/O error that can leave a half-written tar in the archive dir.
# Use nolock,soft,rw only if you would rather the container not hang when the
# NFS server is unreachable.
#NAS_OPTIONS=nolock,hard,rw

# Share 1: server export -> in-container mount point.
#NAS_SHARE1_EXPORT=/export/photos
#NAS_SHARE1_TARGET=/share/share1

# Share 2: server export -> in-container mount point.
#NAS_SHARE2_EXPORT=/export/photos-2
#NAS_SHARE2_TARGET=/share/share2

# ─────────────────────────────────────────────────────────────────────────────
# Optional (app defaults shown - uncomment only to change). These are forwarded
# to the container via the compose environment: block.
# ─────────────────────────────────────────────────────────────────────────────

# Published image tag; ./start.sh --pull refreshes it.
#IMPORTRR_TAG=latest

# Set to 0/false/no to disable the Prometheus /metrics server.
#METRICS_ENABLED=true

# Port the /metrics server binds; also the published host port.
#METRICS_PORT=9201

# Host interface the metrics port is published on. Default 0.0.0.0 (all
# interfaces, same as a bare "9201:9201"). Set 127.0.0.1 to expose /metrics
# only to a Prometheus running on the Docker host.
#METRICS_HOST=0.0.0.0
